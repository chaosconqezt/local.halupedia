# OPENAI_API_KEY: Required for LLM API calls.
# If using local llama.cpp or compatible API, set anything here.
OPENAI_API_KEY="sk-fake-key"

# OPENAI_BASE_URL: URL base for LLM requests.
# Set this to "http://127.0.0.1:8080/v1" for local llama.cpp, or keep it empty for OpenRouter.
OPENAI_BASE_URL="http://127.0.0.1:8080/v1"

# LLM_MODEL: The model to request.
LLM_MODEL="local-model"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
